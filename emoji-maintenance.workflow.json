      "parameters": {
        "jsCode": "// 临时节点：跑一次，输出可直接粘进清洗节点的 EMOJI_MAP\nconst sliceUtf16 = (s, start, end) => {\n  const buf = Buffer.from(s, 'utf16le');\n  return buf.subarray(start * 2, end * 2).toString('utf16le');\n};\n\nconst seen = new Map();\nfor (const item of $input.all()) {\n  const msg = item.json?.message || item.json;\n  const text = msg?.text || msg?.caption || '';\n  const ents = msg?.entities || msg?.caption_entities || [];\n  for (const ent of ents) {\n    if (ent.type !== 'custom_emoji') continue;\n    const emoji = sliceUtf16(text, ent.offset, ent.offset + ent.length);\n    const id = String(ent.custom_emoji_id);\n    if (!seen.has(emoji)) seen.set(emoji, id);\n  }\n}\n\nconst lines = Array.from(seen.entries())\n  .map(([e, id]) => `  ${JSON.stringify(e)}: ${JSON.stringify(id)},`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    count: seen.size,\n    code: `const EMOJI_MAP = {\\n${lines}\\n};`\n  }\n}];"
      },

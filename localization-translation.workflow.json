        "jsCode": "let aiOutput = $json.output || \"\";\n// 清理 AI 可能带出的 markdown 代码块标记\naiOutput = aiOutput.replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsed = {};\ntry {\n  parsed = JSON.parse(aiOutput);\n} catch(e) {\n  // 解析失败的兜底\n  parsed = { error: \"JSON Parse Failed\", raw: aiOutput };\n}\n\n// 核心修复：使用 .first() 强制回溯源头节点拿品牌\nconst originalBrand = $('When Executed by Another Workflow').first().json.brand || \"[BRAND_C]\";\n\nreturn {\n  json: {\n    brand: originalBrand, // 确保带出去\n    ...parsed // 展开语言字段 en, ru, pt 等\n  }\n};"
